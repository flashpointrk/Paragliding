# next-auth@4 lists nodemailer@^7 as a peerOptional dependency, while this
# project uses nodemailer@9 (the mail code was written against it). That peer
# mismatch makes npm 7+ fail `npm ci`/`npm install` with ERESOLVE, the Docker
# image build included. next-auth only needs the dependency for its own e-mail
# provider, which this project does not use.
legacy-peer-deps=true
