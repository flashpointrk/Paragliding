# =====================================================
# Environment variables (example / template)
# =====================================================
#
# !!! SECURITY WARNING !!!
# This file is a TEMPLATE only. Replace EVERY value before going to production.
# The passwords and secrets below are examples and MUST NOT be used in a real
# deployment. Generate strong, random, unique values instead
# (e.g. `openssl rand -base64 32`).
#
# Usage: copy it with `cp .env.example .env` and fill in the values.
# NEVER commit the .env file.

# --- Application ---
NEXT_PUBLIC_SITE_NAME="Paragliding"
NEXT_PUBLIC_SITE_URL="https://paragliding.local"
SITE_DOMAIN="paragliding.local"

# --- Database (PostgreSQL) ---
# NOTE: make the password strong and unique in production.
# Generating one: `openssl rand -base64 24`
DATABASE_URL="postgresql://parauser:EXAMPLE-Replace-Me-12345@localhost:5432/parasutu?schema=public"

# --- NextAuth.js ---
# Production: generate with `openssl rand -base64 32`.
# Placeholder "replace-me..." values are REJECTED in production (see the
# validation in auth.ts).
NEXTAUTH_SECRET="replace-me-with-a-real-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Contact (public) ---
# Phone numbers, e-mail addresses and personal names are personal data and are
# never stored in the repository. Put the real values only in your own `.env`.
NEXT_PUBLIC_WHATSAPP="+905555555555"
NEXT_PUBLIC_PHONE="+905555555555"
NEXT_PUBLIC_EMAIL="info@paragliding.local"

# Booking contacts — a JSON array. When undefined the contact sections are
# hidden. Fields: name, phone (required); langs, note, noteTr, gender
# (optional). Without `gender` the avatar falls back to the person's initial.
NEXT_PUBLIC_CONTACTS='[{"name":"Full Name","phone":"+90 555 555 55 55","langs":["tr"],"note":"Bookings","noteTr":"Rezervasyon"}]'

# --- Brand identity (public, optional) ---
# Anything left undefined falls back to a neutral default (see src/lib/site.ts).
NEXT_PUBLIC_SITE_SHORT_NAME="Paragliding"
NEXT_PUBLIC_SITE_DESCRIPTION=""
# Operating company / parent brand. When empty the footer's "operated by" line
# is hidden.
NEXT_PUBLIC_OPERATOR=""
# Secondary domain. When empty it is not shown in the footer.
NEXT_PUBLIC_SITE_ALT_URL=""
# Social accounts. When empty the matching icon is hidden.
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_FACEBOOK=""
NEXT_PUBLIC_YOUTUBE=""

# --- Administrator ---
# E-mail of the first admin user, created during the seed
ADMIN_EMAIL="admin@paragliding.local"
# !!! Set a strong ADMIN_PASSWORD on first install !!!
# At least 8 characters; weak values such as "admin123" or "replace-me" are
# rejected. Generate one with `openssl rand -base64 18`.
ADMIN_PASSWORD="EXAMPLE-generate-a-strong-one-12345"
ADMIN_NAME="Site Administrator"

# --- SMTP (mail delivery / NextAuth notifications) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="postmaster@paragliding.local"
# Replace the SMTP password with a real, strong value in production.
SMTP_PASSWORD="EXAMPLE-Replace-Me-smtp-67890"
SMTP_FROM="Paragliding <info@paragliding.local>"

# --- Open-Meteo (weather) ---
# No API key is required; this is for reference only.
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_LAT="36.0"
OPEN_METEO_LON="30.0"

# --- Docker / Postgres (matching docker-compose.yml) ---
# !!! Always change the password in production !!!
POSTGRES_USER="parauser"
POSTGRES_PASSWORD="EXAMPLE-Replace-Me-postgres-9999"
POSTGRES_DB="parasutu"
SEED_SAMPLE_DATA="false"
POSTGRES_BIND_ADDRESS="127.0.0.1"
POSTGRES_HOST_PORT="5433"
