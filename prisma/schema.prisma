// =====================================================
// Prisma schema
// =====================================================
// Models, fields and enum values are named in English, and so are the tables,
// columns and enum types they map to. `@@map` is used only to keep table names
// in snake_case; no name here hides a different identifier in the database.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Roles (role-based access via NextAuth) ---
enum Role {
  ADMIN
  OPERATOR
}

// --- User (NextAuth credentials provider, ADMIN/OPERATOR) ---
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  statusHistory BookingStatusHistory[]

  @@map("users")
}

// --- Login attempts (brute-force protection) ---
// Five failed attempts within 15 minutes for the same e-mail OR IP lock the
// account for 15 minutes. Written from `authorize` and the auth events.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String
  ip         String?
  successful Boolean
  occurredAt DateTime @default(now())

  @@index([email, occurredAt])
  @@index([ip, occurredAt])
  @@map("login_attempts")
}

// =====================================================
// PACKAGES
// =====================================================
model Package {
  id            String   @id @default(cuid())
  name          String
  description   String
  /// What the package includes.
  content       String[]
  /// Turkish copy; the site falls back to the default locale when empty.
  nameTr        String?
  descriptionTr String?
  contentTr     String[] @default([])
  showPrice     Boolean  @default(false)
  /// Minor units (e.g. 2500 TRY = 250000). Display only.
  priceMin      Int?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]

  @@map("packages")
}

// =====================================================
// PILOTS
// =====================================================
model Pilot {
  id              String   @id @default(cuid())
  name            String
  specialty       String
  experienceYears Int
  /// Licence / certification, when the operator is happy to publish it.
  licence         String?
  licenceTr       String?
  /// Spoken languages, e.g. ["TR","EN"].
  languages       String[]
  photoUrl        String?
  /// Short introduction shown on the pilot card.
  bio             String
  specialtyTr     String?
  bioTr           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pilots")
}

// =====================================================
// BOOKINGS (request only — no payment)
// =====================================================
enum BookingStatus {
  PENDING
  CONFIRMED
  POSTPONED
  CANCELLED
  COMPLETED
}

model Booking {
  id                String                 @id @default(cuid())
  packageId         String
  package           Package                @relation(fields: [packageId], references: [id])
  preferredDate     DateTime
  alternateDate     DateTime?
  /// Preferred time of day, e.g. "10:00".
  preferredTime     String?
  guestCount        Int                    @default(1)
  /// "<50" | "50-80" | "80-100" | "100-110" | "110+" | "specify"
  weightRange       String
  fullName          String
  phone             String
  email             String
  locale            String                 @default("EN")
  transferRequested Boolean                @default(false)
  /// "none" | "photo" | "photo-video"
  mediaPreference   String?
  note              String?
  /// Consent under the Turkish personal data protection act (KVKK).
  privacyConsent    Boolean
  explicitConsent   Boolean
  status            BookingStatus          @default(PENDING)
  statusHistory     BookingStatusHistory[]
  outboxEntries     MailOutbox[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status])
  @@index([preferredDate])
  @@map("bookings")
}

model BookingStatusHistory {
  id         String        @id @default(cuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status     BookingStatus
  note       String?
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  occurredAt DateTime      @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

// =====================================================
// WEATHER THRESHOLDS (per launch site)
// =====================================================
model WeatherThreshold {
  id                 String   @id @default(cuid())
  locationName       String   @unique
  lat                Float
  lng                Float
  /// Take-off heading in degrees, compared against the wind direction.
  takeoffHeading     Float
  /// Wind speed ceilings, km/h.
  windMaxGreen       Float
  windMaxAmber       Float
  /// Gust-over-wind delta ceilings, km/h.
  gustDeltaMaxGreen  Float
  gustDeltaMaxAmber  Float
  /// Precipitation ceilings, mm.
  precipMaxGreen     Float
  precipMaxAmber     Float
  /// Visibility floors, km.
  visibilityMinGreen Float
  visibilityMinAmber Float
  /// Acceptable wind-direction sector, degrees.
  windSectorMin      Float?
  windSectorMax      Float?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("weather_thresholds")
}

// =====================================================
// CONTACT SETTINGS (single row)
// =====================================================
model ContactSettings {
  /// Single row, addressed by the fixed "global" id.
  id               String   @id @default(cuid())
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  openingHours     String?
  openingHoursTr   String?
  /// Google Maps embed URL.
  mapEmbed         String?
  facebook         String?
  instagram        String?
  youtube          String?
  // --- Cloudflare Turnstile (bot protection) ---
  // When disabled the verification step is skipped; the keys only matter while
  // enabled, and both must be present in that case.
  turnstileEnabled Boolean  @default(false)
  /// Public — safe to use in the client widget.
  turnstileSiteKey String?
  /// SECRET — server-side only, used for siteverify.
  turnstileSecret  String?
  updatedAt        DateTime @updatedAt

  @@map("contact_settings")
}

// =====================================================
// CONTACT REQUESTS AND MAIL OUTBOX
// =====================================================
model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  outboxEntries MailOutbox[]

  @@index([createdAt])
  @@map("contact_requests")
}

enum MailOutboxType {
  CONTACT_ADMIN
  BOOKING_CUSTOMER
  BOOKING_ADMIN
}

// Mail delivery is decoupled from the HTTP request: the record is queued first
// and a worker retries failed sends with an increasing backoff.
model MailOutbox {
  id               String         @id @default(cuid())
  type             MailOutboxType
  recipient        String?
  bookingId        String?
  contactRequestId String?
  attemptCount     Int            @default(0)
  nextAttemptAt    DateTime       @default(now())
  lastError        String?
  sentAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contactRequest ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)

  @@index([sentAt, nextAttemptAt])
  @@index([bookingId])
  @@index([contactRequestId])
  @@map("mail_outbox")
}

// =====================================================
// FAQ
// =====================================================
model Faq {
  id         String  @id @default(cuid())
  question   String
  answer     String
  /// Turkish copy; the site falls back to the default locale when empty.
  questionTr String?
  answerTr   String?
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  @@map("faqs")
}

// =====================================================
// BLOG (phase 2)
// =====================================================
model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String
  /// Markdown.
  content     String
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  author      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

// =====================================================
// GALLERY MEDIA
// =====================================================
model GalleryMedia {
  id        String   @id @default(cuid())
  url       String
  title     String?
  altText   String?
  /// Turkish copy; the site falls back to the default locale when empty.
  titleTr   String?
  altTextTr String?
  /// Intrinsic pixel size, required by the uncropped masonry layout. When empty
  /// the page falls back to a safe default; `scripts/backfill-gallery-sizes.ts`
  /// fills existing rows in.
  width     Int?
  height    Int?
  /// "takeoff" | "inflight" | "landing" | "guest"
  category  String
  /// "image" | "video" — decides between <Image> and <video> when rendering.
  type      String   @default("image")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery_media")
}

// =====================================================
// PAGE CONTENT
// =====================================================
model PageContent {
  id        String   @id @default(cuid())
  slug      String
  locale    String   @default("tr")
  title     String
  content   Json
  images    Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@map("page_contents")
}

model PageMedia {
  id        String   @id @default(cuid())
  url       String   @unique
  title     String?
  altText   String?
  width     Int?
  height    Int?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("page_media")
}
