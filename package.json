{
  "name": "paragliding-site",
  "version": "0.1.0",
  "private": true,
  "description": "Tandem paragliding booking and operations site",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:tandem-packages": "SEED_TANDEM_PACKAGES=true tsx --env-file=.env prisma/seed.ts",
    "db:seed:faq": "SEED_FAQ=true tsx --env-file=.env prisma/seed.ts",
    "db:seed:weather-threshold": "SEED_WEATHER_THRESHOLD=true tsx --env-file=.env prisma/seed.ts",
    "mail:outbox": "tsx --env-file=.env scripts/drain-outbox.ts",
    "db:backfill-gallery-sizes": "tsx --env-file=.env scripts/backfill-gallery-sizes.ts",
    "db:import-media": "tsx --env-file=.env scripts/import-media-library.ts",
    "db:migrate-legacy-values": "tsx --env-file=.env scripts/migrate-legacy-values.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "next-auth": "^4.24.10",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.11",
    "postcss": "8.5.22",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
