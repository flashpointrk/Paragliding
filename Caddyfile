# =====================================================
# Caddyfile
# =====================================================
# Reverse proxy + otomatik TLS.
# In production, replace "yamacparasutu.local" with your real domain. As long
# as the domain resolves in public DNS, Caddy obtains and renews a Let's Encrypt
# TLS certificate automatically.

# --- Production (the real domain) ---
{$SITE_DOMAIN} {
	encode gzip zstd

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		X-DNS-Prefetch-Control "off"
		X-Permitted-Cross-Domain-Policies "none"

		# Content Security Policy (including the Turnstile domains)
		# Not: Next.js 'unsafe-inline' gerektirir (script + style). Nonce-based CSP faz 2.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Caddy hides its own Server header
		-Server
	}

	# Raise the request body limit for the bulk gallery upload route (videos
	# included). Server side the per-file video limit is 200 MB
	# (see src/app/api/admin/gallery/upload/route.ts), and the client posts in
	# batches (at most 6 files per request), so 250 MB leaves enough headroom. Stating
	# it explicitly rather than relying on Caddy's default (unlimited) means a
	# future global body limit cannot silently start rejecting large video
	# uploads with a 413.
	@galleryUpload path /api/admin/gallery/upload
	request_body @galleryUpload {
		max_size 250MB
	}

	# Proxy to the Next.js application
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# --- Local development (no TLS, optional) ---
# Uncomment this block and comment out the "yamacparasutu.local" line:
# http://localhost {
# 	encode gzip zstd
# 	reverse_proxy web:3000
# }
